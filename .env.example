# 도메인
PUBLIC_HOST=science26.bssm.dev
UPLOAD_HOST=science26-upload.bssm.dev

# 인증
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 학교 구글 Workspace 도메인 (hd 클레임). 쉼표로 여러 개 가능
ALLOWED_GOOGLE_DOMAINS=bssm.hs.kr
ADMIN_EMAILS=26_51@bssm.hs.kr, startea0716@gmail.com
COOKIE_SECURE=true

# 비밀값 (scripts/gen-secrets.sh 로 생성)
SECRET_KEY=
ENV_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 운영
# Let's Encrypt 만료 알림 받을 이메일
ACME_EMAIL=
DATA_ROOT=/data
TRAEFIK_HTTP_PORT=80
DISCORD_WEBHOOK_URL=
# 활동 알림(첫 접속·프로젝트 등록·수정)에서 멘션할 디스코드 사용자 ID, 쉼표로 여러 명
DISCORD_MENTION_USER_IDS=

# 관리자 안내 메일 (관리자 화면 '안내 메일 보내기'). Gmail·학교 구글 계정이면
# 구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 를 만들어 SMTP_PASSWORD 에 넣는다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 보내는 주소 (비우면 SMTP_USER), 보내는 이름
SMTP_FROM=
SMTP_FROM_NAME=science26
